# ==================================================
# Shared environment settings
# Dùng chung cho toàn bộ project ở thư mục source
# ==================================================

# Tên ứng dụng hiển thị chung cho frontend và backend
APP_NAME=Website bán gói tour du lịch Chill n Free

# Môi trường chạy hiện tại: development | production | test
APP_ENV=development

# ==================================================
# Shared app runtime
# Ứng dụng frontend và backend cùng chạy trên một cổng
# ==================================================

# Cổng dùng chung cho toàn bộ app
PORT=4000

# Tên ứng dụng hiển thị trong frontend
VITE_APP_NAME=Website bán gói tour du lịch Chill n Free

# ==================================================
# Landing page effects
# Đổi hiệu ứng hero theo mùa hoặc theo concept quảng bá
# none | leaves | particles | stars | snow | petals | clouds | birds | sparkles
# ==================================================

# Kiểu hiệu ứng cho banner đầu trang chủ
VITE_HERO_EFFECT=leaves

# Số lượng phần tử hiệu ứng
# Gợi ý:
# leaves 14-24 | particles 18-30 | stars 6-10 | snow 18-32
# petals 12-22 | clouds 3-6 | birds 3-7 | sparkles 12-24
VITE_HERO_EFFECT_COUNT=18

# Tốc độ hiệu ứng, càng lớn thì chuyển động càng nhanh
# Gợi ý trong khoảng 0.6 - 1.6
VITE_HERO_EFFECT_SPEED=1

# Tỷ lệ phóng to/thu nhỏ hiệu ứng
# Gợi ý trong khoảng 0.8 - 1.3
VITE_HERO_EFFECT_SCALE=1

# Độ đậm của hiệu ứng từ 0 đến 1
# Gợi ý trong khoảng 0.45 - 0.85 để vẫn nhìn rõ nội dung
VITE_HERO_EFFECT_OPACITY=0.72

# ==================================================
# Database settings
# Thông tin kết nối MySQL
# ==================================================

# Host của MySQL
DB_HOST=localhost

# Port mặc định của MySQL
DB_PORT=3306

# Tên database chính của project
DB_NAME=tour_db

# Tài khoản kết nối database
DB_USER=root

# Mật khẩu database, để trống nếu máy local chưa đặt password
DB_PASSWORD=123456

# ==================================================
# Authentication settings
# Cấu hình xác thực JWT cho backend
# ==================================================

# Chuỗi bí mật để ký access token, cần thay đổi khi đưa lên môi trường thật
JWT_SECRET=change_me_for_real_project

# Chuỗi bí mật để ký refresh token, cần thay đổi khi đưa lên môi trường thật
REFRESH_TOKEN_SECRET=change_me_for_real_project_refresh

# Thời gian hết hạn access token
ACCESS_TOKEN_EXPIRES_IN=7h

# Thời gian hết hạn refresh token
REFRESH_TOKEN_EXPIRES_IN=1d

# ==================================================
# PayOS payment settings
# Key PayOS chi duoc dung o backend, khong dat duoi dang VITE_*
# ==================================================

PAYOS_CLIENT_ID=1b30bbee-c89c-4410-93a2-c8c325f9bf73
PAYOS_API_KEY=fdb70064-92d4-4253-b668-c334c8de5a02
PAYOS_CHECKSUM_KEY=b990d71d908b417472613483f17c7747191bb16255c1e4b7ed59910cb35f185a
PAYOS_RETURN_URL=http://localhost:4000/payment/:bookingId
PAYOS_CANCEL_URL=http://localhost:4000/payment/:bookingId
PAYOS_WEBHOOK_URL=http://localhost:4000/api/payments/payos/webhook
